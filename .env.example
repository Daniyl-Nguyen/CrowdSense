# Copy to .env for local configuration. Never commit credentials.
# Local development works without AWS or account settings.

# --- Server ---
PORT=8787
WEB_PORT=5173
# HTTPS website origin used for QR codes, account callbacks, and request protection.
PUBLIC_URL=
# Persistent session metadata and account-cookie encryption key.
DATA_DIR=.data

# --- AWS S3: private recordings and reports ---
AWS_REGION=us-east-2
# Leave these empty when using an AWS profile or instance credentials.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# Only needed with temporary AWS credentials.
AWS_SESSION_TOKEN=
# Empty uses local storage. A configured bucket must be reachable at startup.
S3_BUCKET=
# Keep off with bucket-only credentials; coaching uses built-in templates.
BEDROCK_ENABLED=0

# --- Accounts: Amazon Cognito ---
# Hosted domain, without https://, and public app client ID (no client secret).
# Callback: PUBLIC_URL/api/auth/callback; logout: PUBLIC_URL/account.
COGNITO_DOMAIN=
COGNITO_CLIENT_ID=

# --- Local speech transcription: no API key required ---
WHISPER_ENABLED=1
WHISPER_MODEL=onnx-community/whisper-tiny.en

# --- Hugging Face: hosted AI coaching and speech transcription ---
# Fine-grained token with "Make calls to Inference Providers" permission.
# Server-only secret. Hosted features send transcript/metrics or audio to HF providers.
HF_TOKEN=
HF_COACH_ENABLED=1
HF_COACH_MODEL=openai/gpt-oss-120b
HF_ASR_ENABLED=1
HF_ASR_MODEL=openai/whisper-large-v3
