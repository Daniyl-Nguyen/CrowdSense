# Copy to .env. Every key is optional: missing keys fall back gracefully (shown on the dashboard).

# --- Server ---
PORT=8787
# Public URL for QR codes when using a tunnel (e.g. https://xyz.trycloudflare.com)
PUBLIC_URL=
# "demo" halves nudge hold times so a 2-minute demo shows coaching quickly
NUDGE_SPEED=

# --- Neon Postgres (system of record). Fallback: JSON files in .data/ ---
NEON_DATABASE_URL=

# --- AWS (S3 recordings/transcripts/reports, Bedrock coaching). Fallback: local disk + Anthropic/templates ---
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=
S3_BUCKET=
# Claude model ID on Bedrock (default anthropic.claude-opus-5-5)
BEDROCK_MODEL_ID=
# Set to 0 to skip Bedrock even when AWS creds exist
BEDROCK_ENABLED=

# --- Anthropic API (coaching fallback if Bedrock is unavailable) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# --- Hugging Face Whisper (runs locally on the server via Transformers.js; downloads once) ---
WHISPER_ENABLED=1
# onnx-community/whisper-tiny.en is faster on slow CPUs; whisper-small.en is more accurate
WHISPER_MODEL=onnx-community/whisper-base.en

# --- Optional extras ---
GEMINI_API_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
