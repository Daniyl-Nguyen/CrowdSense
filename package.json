{
  "name": "crowdsense",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,web -c yellow,cyan \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node scripts/dev-server.mjs",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts",
    "start": "NODE_ENV=production tsx server/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "simulate": "tsx scripts/simulate.ts",
    "postinstall": "node scripts/fetch-models.mjs || true",
    "dev:lan": "HTTPS=1 npm run dev",
    "s3:setup": "tsx scripts/s3-setup.ts"
  },
  "dependencies": {
    "@anthropic-ai/bedrock-sdk": "^0.34.4",
    "@anthropic-ai/sdk": "^0.133.0",
    "@aws-sdk/client-rekognition": "^3.1149.0",
    "@aws-sdk/client-s3": "^3.1149.0",
    "@aws-sdk/s3-request-presigner": "^3.1149.0",
    "@huggingface/transformers": "^4.3.1",
    "@mediapipe/tasks-vision": "^1.1.0",
    "cors": "^2.8.6",
    "dotenv": "^18.0.7",
    "express": "^5.3.0",
    "google-auth-library": "^11.2.0",
    "onnxruntime-web": "^1.30.0",
    "postgres": "^3.4.9",
    "qrcode": "^1.5.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "tsx": "^4.23.15",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.4"
  },
  "optionalDependencies": {
    "ffmpeg-static": "^5.3.0"
  }
}
